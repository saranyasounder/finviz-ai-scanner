<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alert Outcome Report - {{ generated_at }}</title>
{% from "_data_table.html.jinja" import data_table %}
{% include "_data_table_styles.html.jinja" %}
<style>
  body { font-family: -apple-system, Segoe UI, Arial, sans-serif; background: #0b0e14; color: #e6e6e6; margin: 0; padding: 24px; max-width: 720px; }
  h1 { font-size: 20px; margin-bottom: 4px; }
  .timestamp { color: #9aa4b2; font-size: 13px; margin-bottom: 24px; }
  section { margin-bottom: 32px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; color: #9aa4b2; border-bottom: 1px solid #232838; padding-bottom: 6px; }
  .summary-grid { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
  .summary-tile { background: #131826; border: 1px solid #232838; border-radius: 8px; padding: 12px 16px; min-width: 120px; }
  .summary-tile .value { font-size: 22px; font-weight: 700; }
  .summary-tile .label { font-size: 12px; color: #9aa4b2; text-transform: uppercase; letter-spacing: 0.03em; }
  .status-win { color: #4ade80; font-weight: 600; }
  .status-loss { color: #f87171; font-weight: 600; }
  .status-pending { color: #facc15; font-weight: 600; }
</style>
</head>
<body>

<h1>Alert Outcome Report</h1>
<div class="timestamp">Generated {{ generated_at }}</div>

<section>
  <h2>Summary</h2>
  <div class="summary-grid">
    <div class="summary-tile">
      <div class="value">{{ report.total_signals }}</div>
      <div class="label">Total Signals</div>
    </div>
    <div class="summary-tile">
      <div class="value">{{ "%.1f"|format(report.hit_rate_pct) + "%" if report.hit_rate_pct is not none else "n/a" }}</div>
      <div class="label">Hit Rate (decided)</div>
    </div>
    <div class="summary-tile">
      <div class="value">{{ report.wins }}</div>
      <div class="label">Wins</div>
    </div>
    <div class="summary-tile">
      <div class="value">{{ report.losses }}</div>
      <div class="label">Losses</div>
    </div>
    <div class="summary-tile">
      <div class="value">{{ report.pending }}</div>
      <div class="label">Pending</div>
    </div>
    <div class="summary-tile">
      <div class="value">{{ "%+.2f"|format(report.average_move_pct) + "%" if report.average_move_pct is not none else "n/a" }}</div>
      <div class="label">Avg Move</div>
    </div>
  </div>
</section>

<section>
  <h2>By Conviction Bucket</h2>
  {{ data_table(
    ["Bucket", "Signals", "Wins", "Losses", "Pending", "Hit Rate"],
    bucket_rows
  ) }}
</section>

<section>
  <h2>All Signals</h2>
  {% if entry_rows %}
  {{ data_table(
    ["Ticker", "Signaled At", "Conviction", "Status", "Move %", "Last Checkpoint"],
    entry_rows
  ) }}
  {% else %}
  <p>No signals logged yet.</p>
  {% endif %}
</section>

</body>
</html>
