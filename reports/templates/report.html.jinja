<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Finviz AI Scanner Report - {{ generated_at }}</title>
{% include "_palette.html.jinja" %}
<style>
  body { font-family: -apple-system, Segoe UI, Arial, sans-serif; background: var(--bg-base); color: var(--text-primary); margin: 0; padding: 24px; max-width: 640px; }
  h1 { font-size: 20px; margin-bottom: 4px; color: var(--text-primary); }
  .timestamp { color: var(--text-secondary); font-size: 13px; margin-bottom: 24px; }
  section { margin-bottom: 32px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); border-bottom: 1px solid var(--border); padding-bottom: 6px; }
  h2.section-lead { color: var(--positive); }
  p { color: var(--text-secondary); font-size: 13px; }
  .risk-summary { font-size: 13px; color: var(--text-secondary); }
</style>
</head>
<body>

<h1>Finviz AI Trading Intelligence Report</h1>
<div class="timestamp">Generated {{ generated_at }}</div>

<section>
  <h2>Market Summary</h2>
  <p>{{ market_summary }}</p>
</section>

{#- Part 1: a responsive HTML table, one row per Must-Watch candidate.
    Deliberately table-based with inline styles (not CSS Grid/Flexbox) for
    maximum email-client compatibility - many clients strip <style> blocks
    or ignore CSS custom properties, but reliably render inline style=""
    attributes and plain <table> markup. The ticker column uses
    position:sticky so it stays visible while scrolling horizontally on
    small screens; renderers without sticky support just fall back to
    normal static positioning (no JS, no separate fallback markup needed -
    that's how position:sticky degrades). #}
<section>
  <h2 class="section-lead">Must-Watch Now</h2>
  {% if must_watch %}
  <div style="overflow-x: auto; max-width: 100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; width: 100%; min-width: 560px; font-family: -apple-system, Segoe UI, Arial, sans-serif; font-size: 14px; background-color: #0a0e14; color: #f5f7fa;">
    <thead>
      <tr>
        <th style="position: sticky; left: 0; background-color: #141a24; color: #828ea0; text-align: left; padding: 10px 12px; border-bottom: 1px solid #232c3a; font-size: 12px; text-transform: uppercase;">Ticker</th>
        <th style="background-color: #141a24; color: #828ea0; text-align: left; padding: 10px 12px; border-bottom: 1px solid #232c3a; font-size: 12px; text-transform: uppercase;">Action</th>
        <th style="background-color: #141a24; color: #828ea0; text-align: left; padding: 10px 12px; border-bottom: 1px solid #232c3a; font-size: 12px; text-transform: uppercase;">Entry Zone</th>
        <th style="background-color: #141a24; color: #828ea0; text-align: left; padding: 10px 12px; border-bottom: 1px solid #232c3a; font-size: 12px; text-transform: uppercase;">Stop</th>
        <th style="background-color: #141a24; color: #828ea0; text-align: left; padding: 10px 12px; border-bottom: 1px solid #232c3a; font-size: 12px; text-transform: uppercase;">Target</th>
        <th style="background-color: #141a24; color: #828ea0; text-align: left; padding: 10px 12px; border-bottom: 1px solid #232c3a; font-size: 12px; text-transform: uppercase;">Confidence</th>
        <th style="background-color: #141a24; color: #828ea0; text-align: left; padding: 10px 12px; border-bottom: 1px solid #232c3a; font-size: 12px; text-transform: uppercase;">News</th>
      </tr>
    </thead>
    <tbody>
      {% for stock in must_watch %}
      {% set a = stock.analysis %}
      <tr>
        <td style="position: sticky; left: 0; background-color: #141a24; font-weight: 700; padding: 10px 12px; border-bottom: 1px solid #1b2030; white-space: nowrap;">{{ stock.ticker }}</td>
        {% if a %}
        <td style="padding: 10px 12px; border-bottom: 1px solid #1b2030; white-space: nowrap;">
          <span style="display: inline-block; padding: 3px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; color: #0a0e14; background-color: {% if a.action.value == 'ENTER_NOW' %}#22c55e{% elif a.action.value == 'WAIT_FOR_PULLBACK' %}#facc15{% else %}#f87171{% endif %};">{{ a.action.value.replace('_', ' ') }}</span>
        </td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #1b2030; white-space: nowrap;">{{ "%.2f"|format(a.entry_zone.low) }} - {{ "%.2f"|format(a.entry_zone.high) }}</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #1b2030; white-space: nowrap;">{{ "%.2f"|format(a.stop_loss) }}</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #1b2030; white-space: nowrap;">{{ "%.2f"|format(a.target.price) }}</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #1b2030; white-space: nowrap;">{{ a.confidence.score }} ({{ a.confidence.grade.value }})</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #1b2030; white-space: nowrap;">
          <span style="display: inline-block; padding: 3px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; color: #0a0e14; background-color: {% if a.news_alignment.value == 'CORROBORATED' %}#22c55e{% elif a.news_alignment.value == 'INCONCLUSIVE' %}#facc15{% elif a.news_alignment.value == 'CONFLICTING' %}#f87171{% else %}#5a6472{% endif %};">{{ a.news_alignment.value }}</span>
        </td>
        {% else %}
        <td style="padding: 10px 12px; border-bottom: 1px solid #1b2030; color: #828ea0;" colspan="6">No AI decision this scan</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p>No must-watch candidates this scan.</p>
  {% endif %}
</section>

{#- Part 2: one alert card per ranked candidate. Table-based, inline-styled,
    single column, 16px+ body text - phone-first, same constraints as
    above. The action badge is the largest single element on the card by
    design (20px vs. 16px body text), since it's the one thing meant to be
    readable at a glance. #}
<section>
  <h2>Trade Alerts</h2>
  {% if full_analysis %}
  {% for stock in full_analysis %}
  {% set a = stock.analysis %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; width: 100%; max-width: 100%; background-color: #141a24; border: 1px solid #232c3a; border-radius: 8px; margin-bottom: 12px; font-family: -apple-system, Segoe UI, Arial, sans-serif;">
    <tr>
      <td style="padding: 16px 16px 8px 16px; font-size: 18px; font-weight: 700; color: #f5f7fa;">
        {{ stock.ticker }} <span style="font-size: 13px; color: #828ea0; font-weight: 400;">{{ stock.company }}</span>
      </td>
    </tr>
    {% if a %}
    <tr>
      <td style="padding: 0 16px 12px 16px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
          <tr>
            <td style="background-color: {% if a.action.value == 'ENTER_NOW' %}#22c55e{% elif a.action.value == 'WAIT_FOR_PULLBACK' %}#facc15{% else %}#f87171{% endif %}; color: #0a0e14; font-size: 20px; font-weight: 800; padding: 10px 20px; border-radius: 6px;">{{ a.action.value.replace('_', ' ') }}</td>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding: 0 16px 6px 16px; font-size: 16px; color: #f5f7fa;"><span style="color: #828ea0;">Confidence:</span> {{ a.confidence.score }}/100 ({{ a.confidence.grade.value }})</td>
    </tr>
    <tr>
      <td style="padding: 0 16px 6px 16px; font-size: 16px; color: #f5f7fa;"><span style="color: #828ea0;">Entry:</span> {{ "%.2f"|format(a.entry_zone.low) }} - {{ "%.2f"|format(a.entry_zone.high) }}</td>
    </tr>
    <tr>
      <td style="padding: 0 16px 6px 16px; font-size: 16px; color: #f5f7fa;"><span style="color: #828ea0;">Stop:</span> {{ "%.2f"|format(a.stop_loss) }}</td>
    </tr>
    <tr>
      <td style="padding: 0 16px 6px 16px; font-size: 16px; color: #f5f7fa;"><span style="color: #828ea0;">Target:</span> {{ "%.2f"|format(a.target.price) }} ({{ a.target.risk_reward }})</td>
    </tr>
    <tr>
      <td style="padding: 8px 16px 16px 16px; font-size: 16px; color: #f5f7fa;">{{ a.reasoning }}</td>
    </tr>
    {% else %}
    <tr>
      <td style="padding: 0 16px 16px 16px; font-size: 16px; color: #828ea0;">Analysis unavailable for this stock.</td>
    </tr>
    {% endif %}
  </table>
  {% endfor %}
  {% else %}
  <p>No trade ideas generated this scan.</p>
  {% endif %}
</section>

<section>
  <h2>Risk Summary</h2>
  <p class="risk-summary">{{ risk_summary }}</p>
</section>

</body>
</html>
