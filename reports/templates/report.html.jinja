<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Finviz AI Scanner Report - {{ generated_at }}</title>
{% include "_palette.html.jinja" %}
<style>
  body { font-family: -apple-system, Segoe UI, Arial, sans-serif; background: var(--bg-base); color: var(--text-primary); margin: 0; padding: 24px; max-width: 640px; }
  h1 { font-size: 20px; margin-bottom: 4px; color: var(--text-primary); }
  .timestamp { color: var(--text-secondary); font-size: 13px; margin-bottom: 24px; }
  section { margin-bottom: 32px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); border-bottom: 1px solid var(--border); padding-bottom: 6px; }
  h2.section-lead { color: var(--positive); }
  p { color: var(--text-secondary); font-size: 13px; }

  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .badge-high { background: rgba(34, 197, 94, 0.15); color: var(--positive); }
  .badge-medium { background: rgba(250, 204, 21, 0.15); color: var(--neutral); }
  .badge-low { background: rgba(248, 113, 113, 0.15); color: var(--negative); }

  /* Must-Watch: single-column, large text, minimal fields - built to be
     skimmed on a phone in under 30 seconds. */
  .must-watch-card { background: var(--bg-card); border: 1px solid var(--border); border-left: 4px solid var(--positive); border-radius: 8px; padding: 16px; margin-bottom: 14px; }
  .mw-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .mw-ticker { font-size: 22px; font-weight: 700; color: var(--text-primary); }
  .mw-price { font-size: 18px; color: var(--text-primary); }
  .mw-line { font-size: 14px; color: var(--text-secondary); margin: 4px 0; }
  .mw-reason { font-size: 14px; color: var(--text-primary); margin-top: 8px; }

  /* Per-candidate trade cards below - ticker + conviction score are the
     primary read; AI reasoning is secondary; raw supporting data is
     de-emphasized below a divider so it doesn't compete with the primary read. */
  .trade-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin-bottom: 12px; }
  .fa-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
  .fa-ticker-block { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .fa-ticker { font-size: 18px; font-weight: 700; color: var(--text-primary); }
  .fa-company { font-size: 13px; color: var(--text-secondary); }
  .fa-flag { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }

  .conviction { text-align: right; min-width: 64px; flex-shrink: 0; }
  .conviction-score { font-size: 20px; font-weight: 700; }
  .conviction-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-secondary); }
  .conviction-bar { width: 64px; height: 4px; background: var(--border); border-radius: 2px; margin-top: 4px; overflow: hidden; }
  .conviction-fill { height: 100%; border-radius: 2px; }
  .tier-high .conviction-score { color: var(--positive); }
  .tier-high .conviction-fill { background: var(--positive); }
  .tier-medium .conviction-score { color: var(--neutral); }
  .tier-medium .conviction-fill { background: var(--neutral); }
  .tier-low .conviction-score { color: var(--negative); }
  .tier-low .conviction-fill { background: var(--negative); }

  .fa-reasoning { font-size: 14px; color: var(--text-primary); margin: 10px 0; }
  .fa-levels { font-size: 13px; color: var(--text-primary); margin: 8px 0; }
  .fa-levels strong { color: var(--text-secondary); font-weight: 600; }

  .fa-support { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
  .fa-support p { font-size: 12px; color: var(--text-secondary); margin: 4px 0; }
  .news-row { font-size: 12px; color: var(--text-secondary); margin: 4px 0; }

  .risk-summary { font-size: 13px; color: var(--text-secondary); }

  @media (max-width: 480px) {
    .fa-top { flex-direction: column; align-items: flex-start; gap: 8px; }
    .conviction { text-align: left; }
    .conviction-bar { width: 100px; }
  }
</style>
</head>
<body>

<h1>Finviz AI Trading Intelligence Report</h1>
<div class="timestamp">Generated {{ generated_at }}</div>

<section>
  <h2>Market Summary</h2>
  <p>{{ market_summary }}</p>
</section>

<section>
  <h2 class="section-lead">Must-Watch Now</h2>
  {% for stock in must_watch %}
  <div class="must-watch-card">
    <div class="mw-top">
      <span class="mw-ticker">{{ stock.ticker }}</span>
      <span class="mw-price">${{ "%.2f"|format(stock.price) }}</span>
    </div>
    {% if stock.fibonacci and stock.fibonacci.nearest_support is not none %}
    <div class="mw-line">Entry zone: ~${{ "%.2f"|format(stock.fibonacci.nearest_support) }}</div>
    {% endif %}
    {% if stock.analysis %}
    <div class="mw-line">Stop: {{ stock.analysis.stop_loss }} &nbsp;&nbsp; Target: {{ stock.analysis.profit_target }}</div>
    {% endif %}
    <div class="mw-reason">{{ must_watch_reasons.get(stock.ticker, "") }}</div>
  </div>
  {% else %}
  <p>No must-watch candidates this scan.</p>
  {% endfor %}
</section>

<section>
  <h2>Full Analysis</h2>
  {% for stock in full_analysis %}
  {% set c = conviction[stock.ticker] %}
  <div class="trade-card">
    <div class="fa-top">
      <div>
        <div class="fa-ticker-block">
          <span class="fa-ticker">{{ stock.ticker }}</span>
          <span class="fa-company">{{ stock.company }}</span>
        </div>
        {% if change_reasons.get(stock.ticker) %}
        <div class="fa-flag">{{ change_reasons[stock.ticker] }}</div>
        {% endif %}
      </div>
      <div class="conviction tier-{{ c.tier }}">
        <div class="conviction-score">{{ "%.0f"|format(c.score) }}</div>
        <div class="conviction-label">Conviction</div>
        <div class="conviction-bar"><div class="conviction-fill" style="width: {{ c.pct }}%;"></div></div>
      </div>
    </div>

    {% if stock.analysis %}
    <span class="badge {% if stock.analysis.confidence == 'High' %}badge-high{% elif stock.analysis.confidence == 'Medium' %}badge-medium{% else %}badge-low{% endif %}">
      {{ stock.analysis.confidence }} confidence - Grade {{ stock.analysis.trade_quality }}
    </span>
    <p class="fa-reasoning">{{ stock.analysis.reasoning }}</p>
    <p class="fa-levels"><strong>Entry:</strong> {{ stock.analysis.entry }} &nbsp; <strong>Stop:</strong> {{ stock.analysis.stop_loss }} &nbsp; <strong>Target:</strong> {{ stock.analysis.profit_target }}</p>
    {% else %}
    <p class="fa-reasoning">Analysis unavailable for this stock.</p>
    {% endif %}

    {% if stock.analysis or stock.fibonacci or stock.news_items %}
    <div class="fa-support">
      {% if stock.analysis %}
      <p><strong>Risk:</strong> {{ stock.analysis.risk }}</p>
      {% endif %}
      {% if stock.fibonacci %}
      <p>
        Fibonacci: Swing High {{ "%.2f"|format(stock.fibonacci.swing_high) }} / Swing Low {{ "%.2f"|format(stock.fibonacci.swing_low) }}
        {%- if stock.fibonacci.nearest_support is not none %} / Nearest Support {{ "%.2f"|format(stock.fibonacci.nearest_support) }}{%- endif %}
        ({{ stock.fibonacci.trend.value }})
      </p>
      {% endif %}
      {% if stock.news_items %}
      {% for item, validation in zip(stock.news_items, stock.news_validations) %}
      <p class="news-row">
        <span class="badge {% if validation.verdict.value == 'corroborated' %}badge-high{% elif validation.verdict.value == 'conflicting' %}badge-low{% else %}badge-medium{% endif %}">
          {{ validation.verdict.value }}
        </span>
        "{{ item.headline }}"{% if item.source %} ({{ item.source }}){% endif %}
      </p>
      {% endfor %}
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% else %}
  <p>No trade ideas generated this scan.</p>
  {% endfor %}
</section>

<section>
  <h2>Risk Summary</h2>
  <p class="risk-summary">{{ risk_summary }}</p>
</section>

</body>
</html>
